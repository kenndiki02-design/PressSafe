# Set these in Vercel Project Settings. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_EVIDENCE_BUCKET=presssafe-evidence
ADMIN_INVITE_CODE=generate-a-long-random-admin-bootstrap-code

# Optional integrations; the app reports these unavailable until configured.
RESEND_API_KEY=
SMS_PROVIDER_API_KEY=
FACT_CHECK_PROVIDER_API_KEY=
ANTHROPIC_API_KEY=
BILLING_PROVIDER_SECRET=
CRON_SECRET=
