# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://presssafe:presssafe@localhost:5432/presssafe

# ─── Auth (Auth.js / NextAuth) ──────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="PressSafe <noreply@presssafe.io>"

# ─── SMS / OTP (Africa's Talking) ───────────────────────────
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=PressSafe

# ─── AI (Anthropic Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Fact Check APIs ────────────────────────────────────────
GOOGLE_FACTCHECK_API_KEY=your-google-api-key

# ─── Reverse Image Search ───────────────────────────────────
TINEYE_API_KEY=your-tineye-api-key
GOOGLE_VISION_API_KEY=your-google-vision-key

# ─── Storage (S3-compatible) ────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=presssafe-evidence
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=af-south-1

# ─── Encryption ─────────────────────────────────────────────
EVIDENCE_ENCRYPTION_SALT=change-me-to-random-hex-salt

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PressSafe
NEXT_PUBLIC_APP_DESCRIPTION=Digital verification and safety platform for journalists
