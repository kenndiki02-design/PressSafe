// PressSafe — Full Prisma Schema (all phases)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  JOURNALIST
  EDITOR
  FACT_CHECKER
  ANALYST
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  NEWSROOM
  API
}

enum OrgType {
  NEWSROOM
  MEDIA_BODY
  INDEPENDENT
  ACADEMIC
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REQUIRES_FURTHER_REVIEW
  UNVERIFIED
}

enum VerificationInputType {
  TEXT
  URL
  IMAGE
  VIDEO
  DOCUMENT
}

enum EvidenceType {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
  NOTE
  SCREENSHOT
}

enum IncidentType {
  THREAT
  HARASSMENT
  PHYSICAL_ATTACK
  ARREST_DETENTION
  EQUIPMENT_SEIZURE
  ONLINE_ABUSE_DOXXING
  LEGAL_ACTION
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

enum ReviewTaskStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
}

enum CheckInStatus {
  ACTIVE
  CHECKED_IN
  TRIGGERED
  CANCELLED
}

enum CustodyAction {
  UPLOADED
  VIEWED
  EXPORTED
  SHARED
  METADATA_STRIPPED
  INTEGRITY_CHECKED
  DELETED
}

enum TrainingTier {
  FREE
  PRO
}

// ─── Core User & Org Models ──────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  emailVerified        DateTime?
  emailVerifyToken     String?   @unique
  phone                String?   @unique
  name                 String
  passwordHash         String
  role                 Role      @default(JOURNALIST)
  totpSecret           String?
  totpEnabled          Boolean   @default(false)
  recoveryCodes        String[]  @default([])
  consentedAt          DateTime?
  consentVersion       String?
  simplifiedMode       Boolean   @default(false)
  preferredLocale      String    @default("en")
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  memberships          OrganizationMembership[]
  sessions             Session[]
  cases                Case[]
  verificationRequests VerificationRequest[]
  verificationReports  VerificationReport[]     @relation("ReportReviewedBy")
  evidenceItems        EvidenceItem[]
  custodyLogEntries    CustodyLogEntry[]
  incidents            Incident[]
  trustedContacts      TrustedContact[]
  sosEvents            SOSEvent[]
  checkInTimers        CheckInTimer[]
  reviewTasksAssigned  ReviewTask[]             @relation("AssignedReviewer")
  trainingProgress     UserTrainingProgress[]
  auditLogs            AuditLog[]
  usageMeters          UsageMeter[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  type             OrgType          @default(NEWSROOM)
  subscriptionTier SubscriptionTier @default(FREE)
  logoUrl          String?
  website          String?
  country          String           @default("KE")
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  memberships OrganizationMembership[]
  cases       Case[]
  incidents   Incident[]
  usageMeters UsageMeter[]

  @@index([slug])
  @@index([type])
}

model OrganizationMembership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(JOURNALIST)
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ─── Cases / Stories ─────────────────────────────────────────────────────────

model Case {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerId     String
  orgId       String?
  tags        String[] @default([])
  status      String   @default("ACTIVE")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner                User                  @relation(fields: [ownerId], references: [id])
  org                  Organization?         @relation(fields: [orgId], references: [id])
  verificationRequests VerificationRequest[]
  evidenceItems        EvidenceItem[]

  @@index([ownerId])
  @@index([orgId])
  @@index([status])
  @@index([createdAt])
}

// ─── Module A: Verification ──────────────────────────────────────────────────

model VerificationRequest {
  id          String                @id @default(cuid())
  caseId      String?
  submittedBy String
  type        VerificationInputType @default(TEXT)
  rawInput    String
  fileKey     String?
  fileHash    String?
  metadata    Json?                 @default("{}")
  status      VerificationStatus    @default(PENDING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  case   Case? @relation(fields: [caseId], references: [id])
  author User  @relation(fields: [submittedBy], references: [id])

  report     VerificationReport?
  reviewTask ReviewTask?

  @@index([submittedBy])
  @@index([caseId])
  @@index([status])
  @@index([createdAt])
}

model VerificationReport {
  id               String             @id @default(cuid())
  requestId        String             @unique
  status           VerificationStatus @default(PENDING)
  confidenceScore  Float              @default(0)
  reasoning        String
  redFlags         String[]           @default([])
  nextSteps        String[]           @default([])
  evidenceLinks    Json               @default("[]")
  aiGenerated      Boolean            @default(true)
  aiModel          String?
  reviewedBy       String?
  reviewedAt       DateTime?
  humanDecision    VerificationStatus?
  humanNotes       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  request  VerificationRequest @relation(fields: [requestId], references: [id])
  reviewer User?               @relation("ReportReviewedBy", fields: [reviewedBy], references: [id])

  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

// ─── Module B: Evidence Vault ────────────────────────────────────────────────

model EvidenceItem {
  id                    String       @id @default(cuid())
  caseId                String?
  uploadedBy            String
  type                  EvidenceType
  title                 String?
  description           String?
  encryptedBlobKey      String
  sha256Hash            String       @unique
  sizeBytes             Int
  mimeType              String
  originalMetadata      Json?        @default("{}")
  strippedMetadataCopy  String?
  isMetadataStripped    Boolean      @default(false)
  accessControl         Json         @default("{}")
  tags                  String[]     @default([])
  custodyChainHead      String?
  integrityVerifiedAt   DateTime?
  certificateUrl        String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  case          Case?             @relation(fields: [caseId], references: [id])
  uploader      User              @relation(fields: [uploadedBy], references: [id])
  custodyLog    CustodyLogEntry[]

  @@index([uploadedBy])
  @@index([caseId])
  @@index([sha256Hash])
  @@index([createdAt])
}

model CustodyLogEntry {
  id            String        @id @default(cuid())
  evidenceId    String
  actorId       String
  action        CustodyAction
  previousHash  String?
  currentHash   String
  metadata      Json?         @default("{}")
  notes         String?
  timestamp     DateTime      @default(now())

  evidence EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  actor    User         @relation(fields: [actorId], references: [id])

  @@index([evidenceId])
  @@index([actorId])
  @@index([timestamp])
}

// ─── Module C: Safety & Incidents ───────────────────────────────────────────

model Incident {
  id                String           @id @default(cuid())
  reportedBy        String
  orgId             String?
  type              IncidentType
  severity          IncidentSeverity @default(MEDIUM)
  occurredAt        DateTime
  latitude          Float?
  longitude         Float?
  locationText      String?
  county            String?
  description       String
  perpetrators      String?
  witnesses         String?
  linkedEvidenceIds String[]         @default([])
  status            IncidentStatus   @default(DRAFT)
  consentToShare    Boolean          @default(false)
  isAnonymized      Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  reporter User          @relation(fields: [reportedBy], references: [id])
  org      Organization? @relation(fields: [orgId], references: [id])

  @@index([reportedBy])
  @@index([orgId])
  @@index([type])
  @@index([county])
  @@index([occurredAt])
  @@index([status])
}

model TrustedContact {
  id                  String  @id @default(cuid())
  userId              String
  name                String
  phone               String?
  email               String?
  relationship        String?
  notifyOnSOS         Boolean @default(true)
  notifyOnMissedCheckin Boolean @default(true)
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SOSEvent {
  id                 String    @id @default(cuid())
  userId             String
  triggeredAt        DateTime  @default(now())
  latitude           Float?
  longitude           Float?
  message            String?
  contactsNotified   String[]  @default([])
  resolvedAt         DateTime?
  resolvedNotes      String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([triggeredAt])
}

model CheckInTimer {
  id              String        @id @default(cuid())
  userId          String
  dueAt           DateTime
  intervalMinutes Int           @default(60)
  status          CheckInStatus @default(ACTIVE)
  label           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([dueAt])
}

// ─── Manual Review Queue ─────────────────────────────────────────────────────

model ReviewTask {
  id          String           @id @default(cuid())
  requestId   String           @unique
  assignedTo  String?
  status      ReviewTaskStatus @default(PENDING)
  notes       String?
  decision    VerificationStatus?
  priority    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?

  request  VerificationRequest @relation(fields: [requestId], references: [id])
  reviewer User?               @relation("AssignedReviewer", fields: [assignedTo], references: [id])

  @@index([requestId])
  @@index([assignedTo])
  @@index([status])
}

// ─── Module D: Training ──────────────────────────────────────────────────────

model TrainingModule {
  id              String      @id @default(cuid())
  slug            String      @unique
  titleEn         String
  titleSw         String
  descriptionEn   String?
  descriptionSw   String?
  contentJson     Json        @default("{}")
  durationMinutes Int         @default(10)
  tier            TrainingTier @default(FREE)
  order           Int         @default(0)
  isPublished     Boolean     @default(true)
  createdAt       DateTime    @default(now())

  progress UserTrainingProgress[]

  @@index([slug])
  @@index([tier])
  @@index([order])
}

model UserTrainingProgress {
  id          String    @id @default(cuid())
  userId      String
  moduleId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  score       Int?
  attempts    Int       @default(1)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

// ─── Audit & Usage ───────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?    @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model UsageMeter {
  id                  String   @id @default(cuid())
  userId              String?
  orgId               String?
  month               String
  verificationsUsed   Int      @default(0)
  storageUsedBytes    BigInt   @default(0)
  sosEventsCount      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User?         @relation(fields: [userId], references: [id])
  org  Organization? @relation(fields: [orgId], references: [id])

  @@unique([userId, month])
  @@index([orgId])
  @@index([month])
}
